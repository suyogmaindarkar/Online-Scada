# ═══════════════════════════════════════════════════════════
# OnlineSCADA Backend Environment Variables
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/onlinescada
# Alternative: MONGO_URI=mongodb://localhost:27017/onlinescada

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# InfluxDB Configuration (Optional - for trend data storage)
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=your-org
INFLUXDB_BUCKET=onlinescada

# Email Configuration (Optional - for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@onlinescada.in

# CORS Configuration (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000,https://onlinescada.in,https://www.onlinescada.in,https://app.onlinescada.in

# Frontend URL (for CORS in production)
FRONTEND_URL=https://online-scada.vercel.app
