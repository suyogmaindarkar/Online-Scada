# ═══════════════════════════════════════════════════════════
# OnlineSCADA Frontend Environment Variables
# Copy this file to .env and fill in your actual values
# ═══════════════════════════════════════════════════════════

# Backend API URL
# Development: http://localhost:5000/api
# Production: https://your-backend-domain.com/api
VITE_API_URL=http://localhost:5000/api

# Public Windows installer URL used by the Factory Connector setup dialog.
# Preferred custom subdomain: https://connector.onlinescada.in/OnlineSCADA-Factory-Connector-Setup.exe
# A GitHub Release or another public HTTPS artifact URL also works.
VITE_CONNECTOR_INSTALLER_URL=https://connector.onlinescada.in/OnlineSCADA-Factory-Connector-Setup.exe
